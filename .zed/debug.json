// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Build & Debug Rust binary leet_code_programs",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/leet_code_programs",
    "request": "launch",
    "adapter": "CodeLLDB", // GDB is available on non arm macs as well as linux
  },
  {
    "label": "Build & Debug Rust binary main2",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/main2",
    "request": "launch",
    "adapter": "CodeLLDB", // GDB is available on non arm macs as well as linux
  },
]
